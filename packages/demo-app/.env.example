# Public Sepolia RPC (used by wagmi/viem in the browser) — set in Vercel project env
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Deployed TrustMeshVerifier (see docs/deployments.md)
NEXT_PUBLIC_TRUSTMESH_VERIFIER_ADDRESS=0x4d871E1Dd2193769b4634a27582be18A2962b38c

# Agent address shown in the dashboard (deployer / registered agent)
NEXT_PUBLIC_AGENT_ADDRESS=0x8aff698EBd8d18B3A5dd2bDFb6E2A2196e489994

# Block to start scanning VerifiedDecision logs (TrustMeshVerifier deploy block)
NEXT_PUBLIC_FROM_BLOCK=11322690

# Backend demo runner — Python e2e script reads packages/prover/e2e/.env for keys/RPC
# NEVER enable on public deployments without DEMO_API_SECRET
DEMO_API_ENABLED=false
DEMO_API_SECRET=
DEMO_PYTHON=python
DEMO_PROVER_DIR=../prover
