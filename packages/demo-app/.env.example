# Public Sepolia RPC (used by wagmi/viem in the browser) — set in Vercel project env
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# WalletConnect / Reown project ID — required for mobile wallet connections
# Create one at https://cloud.reown.com (formerly cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public app URL used in WalletConnect metadata (production domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (Project Settings → API)
# https://supabase.com/dashboard — enable Email provider under Authentication → Providers
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the classic name; publishable key is also accepted by the app
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# After creating a project, apply:
#   packages/demo-app/supabase/migrations/20260907120000_create_transactions.sql
# in the Supabase SQL editor (or via supabase db push).

# Deployed TrustMeshVerifier (see docs/deployments.md)
NEXT_PUBLIC_TRUSTMESH_VERIFIER_ADDRESS=0xab6287b4315c19656c5f1cb4249209044fd16a04

# Agent address shown in the dashboard (deployer / registered agent)
NEXT_PUBLIC_AGENT_ADDRESS=0x8aff698EBd8d18B3A5dd2bDFb6E2A2196e489994

# Block to start scanning VerifiedDecision logs (TrustMeshVerifier deploy block)
NEXT_PUBLIC_FROM_BLOCK=11388110

# Backend demo runner — Python e2e script reads packages/prover/e2e/.env for keys/RPC
# NEVER enable on public deployments without DEMO_API_SECRET
DEMO_API_ENABLED=false
DEMO_API_SECRET=
DEMO_PYTHON=python
DEMO_PROVER_DIR=../prover
