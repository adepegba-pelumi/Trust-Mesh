# Public Sepolia RPC (used by wagmi/viem in the browser) — set in Vercel project env
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# WalletConnect / Reown project ID — required for mobile wallet connections
# Create one at https://cloud.reown.com (formerly cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public app URL used in WalletConnect metadata (production domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployed TrustMeshVerifier (see docs/deployments.md — fill after Sepolia deploy)
NEXT_PUBLIC_TRUSTMESH_VERIFIER_ADDRESS=

# Agent address shown in the dashboard (deployer / registered agent)
NEXT_PUBLIC_AGENT_ADDRESS=

# Block to start scanning VerifiedDecision logs (TrustMeshVerifier deploy block)
NEXT_PUBLIC_FROM_BLOCK=

# Backend demo runner — Python e2e script reads packages/prover/e2e/.env for keys/RPC
# NEVER enable on public deployments without DEMO_API_SECRET
DEMO_API_ENABLED=false
DEMO_API_SECRET=
DEMO_PYTHON=python
DEMO_PROVER_DIR=../prover
