# Sepolia e2e demo — copy to .env and fill in (never commit .env)

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deployed TrustMeshVerifier (see docs/deployments.md)
TRUSTMESH_VERIFIER_ADDRESS=0x4d871E1Dd2193769b4634a27582be18A2962b38c

# Allowlisted call target for transactionPayload (defaults to verifier address)
E2E_TARGET_ADDRESS=0xYOUR_ALLOWLISTED_TARGET
