# Copy to `.env` and fill in values before running the README agent example against Sepolia.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_AGENT_PRIVATE_KEY
TRUSTMESH_VERIFIER_ADDRESS=0x4d871E1Dd2193769b4634a27582be18A2962b38c

